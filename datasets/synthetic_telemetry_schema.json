{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MOSAIC-9 Synthetic Research Telemetry Schema",
  "description": "Standardized JSON Schema for Deep Space Astronaut Physiological and Mission Telemetry Models",
  "type": "object",
  "properties": {
    "telemetry_stream": { "type": "string" },
    "is_synthetic": { "type": "boolean", "const": true },
    "calibration_reference": { "type": "string", "enum": ["NASA_HRP_EVIDENCE_BOOK_2025", "NASA_OSDR_BASELINE"] },
    "crew_member_id": { "type": "integer" },
    "mission_day": { "type": "integer" },
    "timestamp": { "type": "string", "format": "date-time" },
    "domain": {
      "type": "string",
      "enum": ["cardiovascular", "musculoskeletal", "neuro_cognitive_sleep", "radiation_environment"]
    },
    "metric_name": { "type": "string" },
    "value": { "type": "number" },
    "unit": { "type": "string" },
    "baseline_reference": { "type": "number" },
    "deviation_zscore": { "type": "number" },
    "confidence_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "quality_flag": {
      "type": "string",
      "enum": ["VERIFIED", "PROVISIONAL", "DEGRADED", "STALE", "UNRELIABLE"]
    }
  },
  "required": ["is_synthetic", "crew_member_id", "mission_day", "timestamp", "domain", "metric_name", "value"]
}
